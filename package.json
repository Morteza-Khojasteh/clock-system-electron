{
  "name": "clock-system-electron",
  "version": "1.0.0",
  "description": "Kiosk-mode staff clock system client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.company.clocksystem",
    "productName": "Clock System",
    "files": [
      "main.js",
      "app/**/*",
      "!app/assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/assets/icon.png",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "app/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morteza-Khojasteh/clock-system-electron.git"
  },
  "keywords": [
    "electron",
    "kiosk",
    "clock",
    "attendance"
  ],
  "author": "Morteza Khojasteh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Morteza-Khojasteh/clock-system-electron/issues"
  },
  "homepage": "https://github.com/Morteza-Khojasteh/clock-system-electron#readme",
  "dependencies": {},
  "devDependencies": {
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1"
  }
}
